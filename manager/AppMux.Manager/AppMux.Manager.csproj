<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AppMux.Manager</AssemblyName>
    <RootNamespace>AppMux.Manager</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\AppMux.ico</ApplicationIcon>
    <Product>AppMux</Product>
    <Description>Layered app instances, simplified.</Description>
    <Company>AppMux</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <Resource Include="Assets\AppMux.png" />
    <Resource Include="Assets\AppMux.ico" />
    <None Include="..\..\target\release\appmux.exe" Link="appmux.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\target\release\appmuxw.exe" Link="appmuxw.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
