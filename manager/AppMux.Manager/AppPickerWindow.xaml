<ui:FluentWindow
    x:Class="AppMux.Manager.AppPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Choose an app: AppMux"
    Icon="Assets/AppMux.ico"
    Width="520"
    Height="640"
    MinWidth="420"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AppMux" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,10">
            <StackPanel Orientation="Horizontal">
                <Image Width="38" Height="38" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{StaticResource AppMuxLogoImage}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Choose an app" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Text="APPMUX · AUTO ROUTE" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                Margin="1,3,0,10"
                FontSize="12"
                Foreground="{DynamicResource SubtleTextBrush}"
                Text="Pick from your Start Menu or from apps that are open right now." />
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <RadioButton
                    x:Name="AllAppsRadio"
                    Checked="OnSourceChanged"
                    Content="All apps"
                    IsChecked="True" />
                <RadioButton
                    x:Name="RunningRadio"
                    Margin="16,0,0,0"
                    Checked="OnSourceChanged"
                    Content="Running now" />
                <RadioButton
                    x:Name="ProcessesRadio"
                    Margin="16,0,0,0"
                    Checked="OnSourceChanged"
                    Content="All processes" />
            </StackPanel>
            <ui:TextBox
                x:Name="SearchBox"
                FontSize="14"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Search apps..."
                TextChanged="OnSearchChanged" />
        </StackPanel>

        <ListView
            x:Name="AppList"
            Grid.Row="2"
            Margin="20,0,20,0"
            Background="Transparent"
            BorderThickness="0"
            MouseDoubleClick="OnItemDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5" Opacity="{Binding RowOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="26"
                            Height="26"
                            Margin="0,0,12,0"
                            Source="{Binding Icon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="14" Text="{Binding Name}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource SubtleTextBrush}"
                                Text="{Binding Location}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button
                Grid.Column="0"
                Click="OnBrowse"
                Content="Browse..."
                Icon="{ui:SymbolIcon FolderOpen24}"
                ToolTip="Pick an .exe or .lnk manually" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="Cancel" />
                <ui:Button
                    x:Name="SelectButton"
                    Appearance="Primary"
                    Click="OnSelect"
                    Content="Select"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
