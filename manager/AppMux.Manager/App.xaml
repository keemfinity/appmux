<Application
    x:Class="AppMux.Manager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BrandNavy">#07163F</Color>
            <Color x:Key="BrandCobalt">#1557F2</Color>
            <Color x:Key="BrandBlue">#2D82FF</Color>
            <Color x:Key="BrandCyan">#61E7F2</Color>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavy}" />
            <SolidColorBrush x:Key="BrandCobaltBrush" Color="{StaticResource BrandCobalt}" />
            <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}" />
            <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}" />
            <SolidColorBrush x:Key="BrandWhiteBrush" Color="#FFF8FBFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#A9BFC6D6" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FF6DDCEB" />
            <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#35FFFFFF" />
            <SolidColorBrush x:Key="IconTileBrush" Color="#18FFFFFF" />
            <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#25FFFFFF" />
                <GradientStop Offset="1" Color="#12FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#34FFFFFF" />
                <GradientStop Offset="1" Color="#20FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandWordmarkBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#FFF8FBFF" />
                <GradientStop Offset="0.46" Color="#FFF8FBFF" />
                <GradientStop Offset="0.47" Color="#FF4C9CFF" />
                <GradientStop Offset="1" Color="#FF1557F2" />
            </LinearGradientBrush>
            <BitmapImage
                x:Key="AppMuxLogoImage"
                CacheOption="OnLoad"
                CreateOptions="IgnoreImageCache"
                UriSource="pack://application:,,,/Assets/AppMux.png" />

            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Effect">
                    <Setter.Value><DropShadowEffect BlurRadius="16" Opacity="0.1" ShadowDepth="4" Color="#05080F" /></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GlassCardHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrandCobaltBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
