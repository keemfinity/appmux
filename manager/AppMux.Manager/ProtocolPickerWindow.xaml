<ui:FluentWindow
    x:Class="AppMux.Manager.ProtocolPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Choose callback instance: AppMux"
    Icon="Assets/AppMux.ico"
    Width="460"
    Height="420"
    MinHeight="320"
    ResizeMode="CanResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AppMux" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="22,8,22,14">
            <StackPanel Orientation="Horizontal">
                <Image Width="38" Height="38" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{StaticResource AppMuxLogoImage}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Continue login in..." />
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Text="SECURE CALLBACK ROUTER" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                x:Name="SchemeText"
                Margin="0,4,0,0"
                FontSize="12"
                Foreground="{DynamicResource SubtleTextBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <ListBox
            x:Name="InstanceList"
            Grid.Row="2"
            Margin="22,0"
            Background="Transparent"
            BorderThickness="0"
            MouseDoubleClick="OnContinue">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Margin="0,0,11,0" Padding="5" Background="{DynamicResource IconTileBrush}" CornerRadius="11">
                                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconSource}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding FriendlyName}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="22,12,22,18" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Click="OnCancel" Content="Cancel" />
            <ui:Button Appearance="Primary" Click="OnContinue" Content="Continue login" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
