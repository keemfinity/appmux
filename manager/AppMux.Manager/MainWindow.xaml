<ui:FluentWindow
    x:Class="AppMux.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AppMux"
    Icon="Assets/AppMux.ico"
    Width="800"
    Height="640"
    MinWidth="560"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AppMux" ShowMaximize="True" ShowMinimize="True" />

        <!-- Header -->
        <Grid Grid.Row="1" Margin="24,8,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="72"
                Height="72"
                Margin="0,0,15,0"
                CornerRadius="18">
                <Image RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{StaticResource AppMuxLogoImage}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="31"
                    FontWeight="Bold"
                    Foreground="{DynamicResource BrandWordmarkBrush}"
                    Text="AppMux" />
                <TextBlock
                    Margin="1,1,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource SubtleTextBrush}"
                    Text="Layered app instances, simplified." />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    x:Name="SettingsButton"
                    Margin="0,0,8,0"
                    Click="OnSettings"
                    Icon="{ui:SymbolIcon Settings24}"
                    ToolTip="Settings" />
                <ui:Button
                    x:Name="SyncMenuButton"
                    Margin="0,0,8,0"
                    Click="OnSyncMenu"
                    Content="Sync right-click menu"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button
                    x:Name="AddButton"
                    Appearance="Primary"
                    Click="OnAddInstance"
                    Content="New instance"
                    Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </Grid>

        <!-- Instance cards -->
        <ScrollViewer
            x:Name="InstanceScroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="InstanceList" Margin="24,0,24,0" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Margin="0,0,13,0"
                                        Padding="6"
                                        Background="{DynamicResource IconTileBrush}"
                                        CornerRadius="13">
                                        <Image
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True"
                                            Source="{Binding Icon}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding AppDisplay}" />
                                            <TextBlock
                                                Margin="9,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource AccentTextBrush}"
                                                Text="{Binding InstanceName}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding RuntimeBrush}"
                                                Text="{Binding RuntimeLabel}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource SubtleTextBrush}"
                                            Text="{Binding Meta}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Primary"
                                            Click="OnLaunch"
                                            Content="Launch"
                                            Icon="{ui:SymbolIcon Play24}"
                                            Tag="{Binding}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Secondary"
                                            Click="OnStop"
                                            Content="Stop"
                                            IsEnabled="{Binding CanStop}"
                                            Tag="{Binding}"
                                            ToolTip="Stop every background process belonging to this instance"
                                            Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Secondary"
                                            Click="OnStrongIsolation"
                                            Icon="{ui:SymbolIcon ShieldLock24}"
                                            IsEnabled="{Binding CanEnableStrongIsolation}"
                                            Tag="{Binding}"
                                            ToolTip="Upgrade to a separate Windows profile"
                                            Visibility="{Binding CanEnableStrongIsolation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ui:Button
                                            Appearance="Secondary"
                                            Click="OnMore"
                                            Content="•••"
                                            Tag="{Binding}"
                                            ToolTip="More actions">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Create desktop shortcut" Click="OnShortcut" Tag="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Remove instance" Click="OnDelete" Tag="{Binding}" />
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="EmptyHint"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource SubtleTextBrush}"
                    Text="No instances yet. Click 'New instance' or right-click any app shortcut → AppMux."
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <TextBlock
            Grid.Row="3"
            Margin="24,12,24,14"
            FontSize="11"
            Foreground="{DynamicResource SubtleTextBrush}"
            Text="Running multiple copies of a program may breach its terms of service. Checking that is your responsibility. Apps with anti-cheat, DRM, or kernel components are declined."
            TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
