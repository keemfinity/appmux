<ui:FluentWindow
    x:Class="AppMux.Manager.NewInstanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="New instance — AppMux"
    Icon="Assets/AppMux.ico"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Topmost="True">

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AppMux" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <StackPanel Orientation="Horizontal">
                <Image Width="38" Height="38" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{StaticResource AppMuxLogoImage}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="New instance" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Text="LAYERED APP INSTANCE" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                x:Name="TargetText"
                Margin="1,4,0,0"
                FontSize="12"
                Foreground="{DynamicResource SubtleTextBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="2" Margin="24,16,24,0" Style="{StaticResource GlassCard}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource SubtleTextBrush}"
                    Text="Instance name — e.g. Work, Personal, Client A" />
                <ui:TextBox
                    x:Name="NameBox"
                    FontSize="14"
                    PlaceholderText="Personal"
                    KeyDown="OnNameKeyDown" />
                <TextBlock
                    x:Name="RouteText"
                    Margin="1,10,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Text="Auto route: analyzing..."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="1,6,0,0"
                    FontSize="11"
                    Foreground="#FFFF9AA2"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="3"
            Margin="25,10,24,0"
            FontSize="11"
            Foreground="{DynamicResource SubtleTextBrush}"
            Text="The instance keeps its own logins and settings between launches."
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="4"
            Margin="24,16,24,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Click="OnCancel"
                Content="Cancel" />
            <ui:Button
                x:Name="CreateButton"
                Appearance="Primary"
                Click="OnCreate"
                Content="Create and launch"
                Icon="{ui:SymbolIcon Play24}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
